# Live mode (Supabase). Leave empty to run in demo mode only.
# Project Settings → API: the Project URL and the anon / publishable key (never the service_role / secret key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: real Snap-to-list with Claude (server-side only). Without it, Snap-to-list shows a demo result.
ANTHROPIC_API_KEY=
